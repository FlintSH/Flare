#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# Format the staged files; lint-staged stages its own changes and nothing else,
# so unstaged and untracked files stay out of the commit.
echo "🔍 Formatting staged files..."
pnpm lint-staged

echo "🧹 Running lint check..."
pnpm lint || (
    echo "❌ Lint check failed. Please fix the issues and commit again."
    exit 1
)
