generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                          String          @id @default(cuid())
  name                        String?
  email                       String?         @unique
  emailVerified               DateTime?
  emailVerifiedFor            String?
  emailVerificationSource     String?
  emailExempt                 Boolean         @default(false)
  pendingEmail                String?
  pendingEmailOldConfirmed    Boolean         @default(false)
  emailTokens                 EmailToken[]
  mailOutbox                  MailOutbox[]
  image                       String?
  password                    String?
  roles                       Role[]
  createdAt                   DateTime        @default(now())
  updatedAt                   DateTime        @updatedAt
  storageUsed                 Float           @default(0)
  sessionVersion              Int             @default(1)
  oidcSubject                 String?         @unique
  vanityId                    String?         @unique
  urlId                       String          @unique
  uploadToken                 String          @unique
  randomizeFileUrls           Boolean         @default(false)
  files                       File[]
  vaultFolders                VaultFolder[]
  vaultTags                   VaultTag[]
  shortenedUrls               ShortenedUrl[]
  defaultFileExpiration       FileExpiration  @default(DISABLED)
  defaultFileExpirationAction ExpiryAction    @default(DELETE)
  preferences                 Json            @default("{}")
  defaultUploadProfileId      String?
  uploadProfiles              UploadProfile[]
  apiTokens                   ApiToken[]
  webhooks                    Webhook[]
}

model Role {
  id          String   @id @default(cuid())
  name        String
  description String   @default("")
  color       String   @default("#64748b")
  position    Int      @default(1)
  permissions String[]
  systemKey   String?  @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]

  @@index([position])
}

model EmailToken {
  id         String       @id @default(cuid())
  userId     String
  email      String
  purpose    String
  tokenHash  String       @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime     @default(now())
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  mail       MailOutbox[]

  @@index([userId, purpose])
  @@index([expiresAt])
}

model MailOutbox {
  id          String      @id @default(cuid())
  userId      String?
  tokenId     String?
  purpose     String
  recipient   String
  payload     String
  status      String      @default("pending")
  attempts    Int         @default(0)
  maxAttempts Int         @default(3)
  availableAt DateTime    @default(now())
  expiresAt   DateTime?
  leaseUntil  DateTime?
  leaseId     String?
  sentAt      DateTime?
  lastError   String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  user        User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  token       EmailToken? @relation(fields: [tokenId], references: [id], onDelete: SetNull)

  @@index([status, availableAt])
  @@index([leaseUntil])
  @@index([createdAt])
}

model EmailRateLimit {
  key     String   @id
  count   Int
  resetAt DateTime

  @@index([resetAt])
}

model File {
  id               String         @id @default(cuid())
  name             String
  urlPath          String         @unique
  mimeType         String
  size             Float
  visibility       FileVisibility @default(PUBLIC)
  uploadedAt       DateTime       @default(now())
  userId           String
  path             String
  isOcrProcessed   Boolean        @default(false)
  ocrText          String?
  password         String?
  isPaste          Boolean        @default(false)
  ocrConfidence    Float?
  ocrTagsPendingAt DateTime?
  views            Int            @default(0)
  downloads        Int            @default(0)
  uploadOptions    Json           @default("{}")
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tags             VaultFileTag[]
  folderId         String?        @map("vaultFolderId")
  folder           VaultFolder?   @relation(fields: [folderId], references: [id], onDelete: SetNull)

  @@index([ocrTagsPendingAt])
  @@index([userId, folderId])
}

// Independent of retired Folder tables: folders organize existing files without
// changing their storage paths, links, tags, or visibility.
model VaultFolder {
  id             String        @id @default(cuid())
  userId         String
  name           String
  normalizedName String
  parentId       String?
  shareToken     String?       @unique
  createdAt      DateTime      @default(now())
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent         VaultFolder?  @relation("FolderTree", fields: [parentId], references: [id], onDelete: NoAction)
  children       VaultFolder[] @relation("FolderTree")
  files          File[]

  // Root names are also unique through a partial index in the migration.
  @@unique([userId, parentId, normalizedName])
  @@index([userId, parentId])
}

// Separate tables from the retired folder feature, whose tables may still
// exist on upgraded installations. Tags never change file paths or visibility.
model VaultTag {
  id             String         @id @default(cuid())
  userId         String
  name           String
  normalizedName String
  ruleSource     String?
  ruleText       String?
  createdAt      DateTime       @default(now())
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  files          VaultFileTag[]

  @@unique([userId, normalizedName])
}

model VaultFileTag {
  fileId   String
  tagId    String
  // A removal is remembered so future OCR processing cannot re-add the tag.
  excluded Boolean  @default(false)
  file     File     @relation(fields: [fileId], references: [id], onDelete: Cascade)
  tag      VaultTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([fileId, tagId])
  @@index([tagId, excluded])
}

model UploadProfile {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  options   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name])
}

model ApiToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  hash       String    @unique
  scopes     String[]
  profileId  String?
  expiresAt  DateTime?
  revokedAt  DateTime?
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

model Webhook {
  id         String            @id @default(cuid())
  userId     String
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  url        String
  secret     String
  enabled    Boolean           @default(true)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  deliveries WebhookDelivery[]

  @@index([userId])
}

model WebhookDelivery {
  id          String    @id @default(cuid())
  eventId     String
  webhookId   String
  webhook     Webhook   @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  payload     Json
  status      String    @default("pending")
  attempts    Int       @default(0)
  availableAt DateTime  @default(now())
  leaseId     String?
  leaseUntil  DateTime?
  lastError   String?
  deliveredAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([webhookId, eventId])
  @@index([status, availableAt])
  @@index([leaseUntil])
}

model ShortenedUrl {
  id        String   @id @default(cuid())
  shortCode String   @unique
  targetUrl String
  clicks    Int      @default(0)
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Config {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt

  @@index([key])
}

// Durable object deletion survives removal of the owning account and its files.
// Targets contain backend identity only; credentials are read fresh by the worker.
model StorageDeletion {
  id          String   @id @default(cuid())
  ownerId     String
  path        String
  provider    String
  target      Json     @default("{}")
  status      String   @default("pending")
  attempts    Int      @default(0)
  availableAt DateTime @default(now())
  leaseId     String?
  leaseUntil  DateTime?
  lastError   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status, availableAt])
  @@index([leaseUntil])
  @@index([ownerId])
}

model Event {
  id          String      @id @default(cuid())
  type        String
  payload     Json
  status      EventStatus @default(PENDING)
  priority    Int         @default(0)
  scheduledAt DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  processedAt DateTime?
  failedAt    DateTime?
  retryCount  Int         @default(0)
  maxRetries  Int         @default(3)
  error       String?
  metadata    Json?

  @@index([type])
  @@index([status])
  @@index([scheduledAt])
  @@index([createdAt])
  @@index([priority, scheduledAt])
}

model EventHandler {
  id        String   @id @default(cuid())
  eventType String
  handler   String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([eventType, handler])
  @@index([eventType])
  @@index([enabled])
}

enum FileVisibility {
  PUBLIC
  PRIVATE
}

enum EventStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  SCHEDULED
}

enum FileExpiration {
  DISABLED
  HOUR
  DAY
  WEEK
  MONTH
}

enum ExpiryAction {
  DELETE
  SET_PRIVATE
}
