# Postgres Configuration
# Format: postgresql://USERNAME:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
DATABASE_URL="postgresql://flare:flarepassword@localhost:5432/flare?schema=public"

# The base URL of your Flare instance
NEXTAUTH_URL="http://localhost:3000"

# A secret key used to encrypt session data, can be anything.
NEXTAUTH_SECRET="your-secret-key-here"

# Optional account email. An upgrade keeps email/recovery/verification disabled.
# Configure in Settings > Email, or override settings here. See docs/email.md.
# FLARE_EMAIL_ENABLED=false
# FLARE_EMAIL_SMTP_HOST="smtp.example.com"
# FLARE_EMAIL_SMTP_PORT=587
# FLARE_EMAIL_SMTP_SECURITY="starttls"
# FLARE_EMAIL_SMTP_USERNAME="flare"
# FLARE_EMAIL_SMTP_PASSWORD_FILE="/run/secrets/flare_smtp_password"
# FLARE_EMAIL_FROM_ADDRESS="flare@example.com"
# FLARE_EMAIL_PUBLIC_URL="https://files.example.com"
# FLARE_EMAIL_RECOVERY_ENABLED=false
# FLARE_EMAIL_VERIFICATION_MODE="off"
# Optional dedicated stable encryption key; otherwise uses NEXTAUTH_SECRET.
# FLARE_EMAIL_ENCRYPTION_KEY_FILE="/run/secrets/flare_email_key"

# Public recording token for development/preview (or explicit test-container opt-in).
# NEXT_PUBLIC_METICULOUS_RECORDING_TOKEN="<YOUR_RECORDING_TOKEN>"

# Optional private-network/HTTP webhook receivers. Default: public HTTPS only.
# See docs/integrations.md before enabling on a shared instance.
# FLARE_WEBHOOK_ALLOW_PRIVATE_NETWORK=false
